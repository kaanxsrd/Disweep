{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disweep",
  "mainBinaryName": "disweep",
  "identifier": "dev.vante.disweep",
  "build": {
    "beforeDevCommand": "bun run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Disweep",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: https://cdn.discordapp.com",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Vante",
    "copyright": "Copyright (C) 2026 Vante",
    "category": "Utility",
    "shortDescription": "Sweep your Discord messages. Review it first.",
    "longDescription": "Find and permanently delete your own Discord messages, with a full preview and an explicit confirmation before anything changes.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
